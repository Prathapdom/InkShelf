<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="InkShelf.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="InkShelf"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="{ThemeResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="{ThemeResource AppBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="18,0,0,0" VerticalAlignment="Center" Orientation="Horizontal" Spacing="10">
                <Image Width="25" Height="25" Source="Assets/Square44x44Logo.targetsize-48_altform-lightunplated.png" />
                <TextBlock VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource InkBrush}" Text="INKSHELF" />
            </StackPanel>
            <TextBlock Grid.Column="1" Margin="16,0,140,0" VerticalAlignment="Center" Foreground="{ThemeResource MutedBrush}" Text="Your comics, beautifully kept" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{ThemeResource NavBackgroundBrush}" BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,1,1,0">
                <Grid Margin="14,22,14,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="6">
                        <TextBlock Margin="12,0,0,10" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource SubtleBrush}" Text="LIBRARY" />
                        <RadioButton x:Name="AllNav" GroupName="Navigation" IsChecked="True" Tag="all" Click="Navigation_Click">
                            <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE8F1;" /><TextBlock Text="All comics" /></StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="Navigation" Tag="continue" Click="Navigation_Click">
                            <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE768;" /><TextBlock Text="Continue reading" /></StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="Navigation" Tag="favorites" Click="Navigation_Click">
                            <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE734;" /><TextBlock Text="Favorites" /></StackPanel>
                        </RadioButton>
                        <Rectangle Margin="8,14,8,10" Height="1" Fill="{ThemeResource LineBrush}" />
                        <TextBlock Margin="12,0,0,4" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource SubtleBrush}" Text="ADD TO LIBRARY" />
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="ImportFiles_Click">
                            <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE8E5;" /><TextBlock Text="Import CBZ files" /></StackPanel>
                        </Button>
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="ImportFolder_Click">
                            <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE8B7;" /><TextBlock Text="Scan a folder" /></StackPanel>
                        </Button>
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="AddSeriesLink_Click">
                            <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE71B;" /><TextBlock Text="Add series link" /></StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Spacing="8">
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE8D4;" /><TextBlock Text="Tracking" /></StackPanel>
                            <Button.Flyout>
                                <Flyout x:Name="TrackingFlyout" Placement="RightEdgeAlignedBottom" Opening="TrackingFlyout_Opening">
                                    <StackPanel Width="330" Spacing="13">
                                        <TextBlock FontSize="19" FontWeight="SemiBold" Text="Reading tracking" />
                                        <TextBlock x:Name="TrackingAccountStatus" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap" Text="AniList is not connected." />
                                        <StackPanel Spacing="5">
                                            <TextBlock Foreground="{ThemeResource MutedBrush}" Text="AniList client ID" />
                                            <TextBox x:Name="TrackingClientIdBox" PlaceholderText="Numeric client ID" />
                                        </StackPanel>
                                        <TextBlock FontSize="12" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap" Text="Create an AniList API client and register this redirect URL:" />
                                        <TextBox IsReadOnly="True" FontFamily="Consolas" FontSize="11" Text="http://127.0.0.1:43871/callback" />
                                        <HyperlinkButton Padding="0" Click="OpenAniListDeveloper_Click" Content="Open AniList developer settings" />
                                        <ToggleSwitch x:Name="AutoSyncToggle" Header="Sync when a comic is completed" IsOn="True" Toggled="AutoSync_Toggled" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button x:Name="ConnectAniListButton" Style="{StaticResource AccentButtonStyle}" Click="ConnectAniList_Click" Content="Connect AniList" />
                                            <Button Click="SyncAll_Click" Content="Sync pending" />
                                            <Button Click="DisconnectAniList_Click" Content="Disconnect" />
                                        </StackPanel>
                                        <TextBlock FontSize="11" Foreground="{ThemeResource SubtleBrush}" TextWrapping="Wrap" Text="Sign-in opens in your browser. The access token is stored in Windows Credential Locker; your password is never seen by InkShelf." />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE790;" /><TextBlock Text="Appearance" /></StackPanel>
                            <Button.Flyout>
                                <Flyout Placement="RightEdgeAlignedBottom" Opening="AppearanceFlyout_Opening">
                                    <StackPanel Width="260" Spacing="14">
                                        <TextBlock FontSize="19" FontWeight="SemiBold" Text="Appearance" />
                                        <StackPanel Spacing="6">
                                            <TextBlock Foreground="{ThemeResource MutedBrush}" Text="Theme" />
                                            <ComboBox x:Name="ThemeBox" HorizontalAlignment="Stretch" SelectionChanged="Appearance_SelectionChanged">
                                                <ComboBoxItem Content="Use system setting" Tag="System" />
                                                <ComboBoxItem Content="Light" Tag="Light" />
                                                <ComboBoxItem Content="Dark" Tag="Dark" />
                                                <ComboBoxItem Content="Midnight (OLED)" Tag="Midnight" />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Spacing="6">
                                            <TextBlock Foreground="{ThemeResource MutedBrush}" Text="Accent color" />
                                            <ComboBox x:Name="AccentBox" HorizontalAlignment="Stretch" SelectionChanged="Appearance_SelectionChanged">
                                                <ComboBoxItem Content="Coral" Tag="Coral" />
                                                <ComboBoxItem Content="Ocean" Tag="Ocean" />
                                                <ComboBoxItem Content="Emerald" Tag="Emerald" />
                                                <ComboBoxItem Content="Violet" Tag="Violet" />
                                            </ComboBox>
                                        </StackPanel>
                                        <TextBlock FontSize="12" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap" Text="Midnight uses pure-black backgrounds for OLED displays. Changes are applied instantly and remembered." />
                                        <Rectangle Height="1" Fill="{ThemeResource LineBrush}" />
                                        <StackPanel Spacing="7">
                                            <TextBlock FontWeight="SemiBold" Text="Web reader cache" />
                                            <TextBlock x:Name="WebCacheSizeText" FontSize="12" Foreground="{ThemeResource MutedBrush}" Text="Calculating…" />
                                            <Button HorizontalAlignment="Left" Click="ClearWebCache_Click" Content="Clear image cache" />
                                            <TextBlock FontSize="11" Foreground="{ThemeResource SubtleBrush}" TextWrapping="Wrap" Text="Clears cached web images without removing site cookies or your chapter history." />
                                        </StackPanel>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Border Padding="12" Background="{ThemeResource SurfaceBrush}" CornerRadius="12">
                            <StackPanel Spacing="5">
                            <TextBlock Foreground="{ThemeResource InkBrush}" FontWeight="SemiBold" Text="Local &amp; private" />
                            <TextBlock FontSize="12" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap" Text="Your comics stay on this PC. Reading progress is saved automatically." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="32,22,32,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="PageTitle" FontSize="30" FontWeight="SemiBold" Foreground="{ThemeResource InkBrush}" Text="All comics" />
                        <TextBlock x:Name="LibraryCount" Margin="0,3,0,0" Foreground="{ThemeResource MutedBrush}" Text="0 titles" />
                    </StackPanel>
                    <TextBox x:Name="SearchBox" Grid.Column="1" Margin="0,2,10,0" Height="40" PlaceholderText="Search your library" TextChanged="SearchBox_TextChanged">
                        <TextBox.HeaderTemplate><DataTemplate /></TextBox.HeaderTemplate>
                    </TextBox>
                    <ComboBox x:Name="SortBox" Grid.Column="2" Margin="0,2,10,0" Height="40" MinWidth="138" SelectedIndex="0" SelectionChanged="SortBox_SelectionChanged">
                        <ComboBoxItem Content="Recently added" Tag="added" />
                        <ComboBoxItem Content="Title A–Z" Tag="title" />
                        <ComboBoxItem Content="Recent activity" Tag="opened" />
                    </ComboBox>
                    <Button Grid.Column="3" Margin="0,2,0,0" Height="40" Style="{StaticResource AccentButtonStyle}" Click="ImportFiles_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE710;" /><TextBlock Text="Import" /></StackPanel>
                    </Button>
                </Grid>

                <Grid Grid.Row="1">
                    <ScrollViewer x:Name="LibraryScroll" Padding="32,0,24,36">
                        <StackPanel Spacing="24">
                            <Border x:Name="ContinueCard" Height="210" Background="{ThemeResource HeroBrush}" CornerRadius="18" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Image x:Name="ContinueCover" Width="118" Height="174" HorizontalAlignment="Center" VerticalAlignment="Bottom" Stretch="UniformToFill" />
                                    <StackPanel Grid.Column="1" Margin="14,26,18,22" VerticalAlignment="Center" Spacing="7">
                                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#FF8A65" Text="CONTINUE READING" />
                                        <TextBlock x:Name="ContinueTitle" MaxLines="2" TextTrimming="CharacterEllipsis" FontSize="25" FontWeight="SemiBold" Foreground="{ThemeResource InkBrush}" />
                                        <TextBlock x:Name="ContinueProgress" Foreground="{ThemeResource MutedBrush}" />
                                        <ProgressBar x:Name="ContinueProgressBar" Margin="0,7,0,0" Height="4" Maximum="100" Foreground="{StaticResource AccentBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Margin="20,0,30,0" VerticalAlignment="Center" Style="{StaticResource AccentButtonStyle}" Click="Continue_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="9"><FontIcon Glyph="&#xE768;" /><TextBlock Text="Continue" /></StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <GridView x:Name="LibraryGrid" IsItemClickEnabled="True" ItemClick="LibraryGrid_ItemClick" SelectionMode="None">
                                <GridView.ItemsPanel>
                                    <ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="0" ItemWidth="190" ItemHeight="330" /></ItemsPanelTemplate>
                                </GridView.ItemsPanel>
                                <GridView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Width="174" Height="312" Margin="0,0,14,18">
                                            <Grid.ContextFlyout>
                                                <MenuFlyout>
                                                    <ToggleMenuFlyoutItem Text="Favorite" Tag="{Binding}" IsChecked="{Binding IsFavorite, Mode=TwoWay}" Click="Favorite_Click" />
                                                    <MenuFlyoutSeparator />
                                                    <MenuFlyoutItem Text="Link to AniList…" Tag="{Binding}" Click="LinkAniList_Click" />
                                                    <MenuFlyoutItem Text="Sync progress now" Tag="{Binding}" Click="SyncBook_Click" />
                                                    <MenuFlyoutItem Text="Unlink tracking" Tag="{Binding}" Click="UnlinkTracker_Click" />
                                                </MenuFlyout>
                                            </Grid.ContextFlyout>
                                            <Grid.RowDefinitions><RowDefinition Height="250" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                            <Border CornerRadius="12" Background="{ThemeResource CardBrush}">
                                                <Grid>
                                                    <Image Source="{Binding CoverImage}" Stretch="UniformToFill" />
                                                    <Border VerticalAlignment="Bottom" Height="62" Background="#B00A0D13">
                                                        <StackPanel Margin="12,9" VerticalAlignment="Bottom">
                                                            <ProgressBar Height="3" Maximum="100" Value="{Binding Progress}" Foreground="{StaticResource AccentBrush}" />
                                                            <TextBlock Margin="0,6,0,0" FontSize="11" Foreground="#E8EAF0" Text="{Binding ProgressLabel}" />
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Row="1" Margin="2,10,2,0" Spacing="3">
                                                <TextBlock MaxLines="2" TextTrimming="CharacterEllipsis" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource InkBrush}" Text="{Binding Title}" />
                                                <TextBlock FontSize="12" Foreground="{ThemeResource MutedBrush}" Text="{Binding ActionLabel}" />
                                                <TextBlock MaxLines="1" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{StaticResource AccentBrush}" Text="{Binding TrackingLabel}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>

                            <Grid x:Name="EmptyState" MinHeight="520">
                                <StackPanel Width="410" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                                    <Image Width="150" Height="150" Source="Assets/LibraryHero.png" />
                                    <TextBlock HorizontalAlignment="Center" FontSize="26" FontWeight="SemiBold" Foreground="{ThemeResource InkBrush}" Text="Build your comic shelf" />
                                    <TextBlock HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource MutedBrush}" Text="Import DRM-free CBZ files and InkShelf will arrange the covers, remember your place, and keep everything ready offline." />
                                    <Button Margin="0,8,0,0" HorizontalAlignment="Center" Style="{StaticResource AccentButtonStyle}" Click="ImportFiles_Click" Content="Choose CBZ files" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                    <ProgressRing x:Name="BusyRing" Width="44" Height="44" IsActive="False" Visibility="Collapsed" />
                </Grid>
            </Grid>
        </Grid>

        <Grid x:Name="ReaderView" Grid.RowSpan="2" Background="#07090D" RequestedTheme="Dark" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="64" /><RowDefinition Height="*" /><RowDefinition Height="82" /></Grid.RowDefinitions>
            <Grid Background="#E610131A">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition x:Name="ReaderCaptionInsetColumn" Width="148" />
                </Grid.ColumnDefinitions>
                <Button Margin="14,10" Click="CloseReader_Click"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72B;" /><TextBlock Text="Library" /></StackPanel></Button>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="ReaderTitle" HorizontalAlignment="Center" FontSize="15" FontWeight="SemiBold" Foreground="White" />
                    <TextBlock x:Name="ReaderCounter" HorizontalAlignment="Center" FontSize="12" Foreground="#96A0AF" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,10,14,10" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SmartZoomButton" Click="SmartZoom_Click" ToolTipService.ToolTip="Analyze speech bubbles and magnify them offline">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE71E;" />
                            <TextBlock x:Name="SmartZoomButtonText" Text="Smart Zoom" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="GuidedViewButton" Click="GuidedView_Click" ToolTipService.ToolTip="Read one detected panel at a time">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE8A9;" />
                            <TextBlock x:Name="GuidedViewButtonText" Text="Guided View" />
                        </StackPanel>
                    </Button>
                    <Button Click="ToggleFullscreen_Click" ToolTipService.ToolTip="Full screen"><FontIcon Glyph="&#xE740;" /></Button>
                    <Button x:Name="ReaderOptionsButton" ToolTipService.ToolTip="Reading options"><FontIcon Glyph="&#xE713;" />
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <StackPanel Width="285" Spacing="14">
                                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="Reading options" />
                                    <StackPanel Spacing="7"><TextBlock Foreground="{ThemeResource MutedBrush}" Text="Layout" /><ComboBox x:Name="LayoutControl" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="LayoutControl_SelectionChanged"><ComboBoxItem Content="Single page" /><ComboBoxItem Content="Two-page spread" /><ComboBoxItem Content="Vertical scroll" /></ComboBox></StackPanel>
                                    <StackPanel Spacing="7">
                                        <TextBlock Foreground="{ThemeResource MutedBrush}" Text="Page turn animation" />
                                        <ComboBox x:Name="PageAnimationBox" HorizontalAlignment="Stretch" SelectionChanged="PageAnimation_SelectionChanged">
                                            <ComboBoxItem Content="None" Tag="None" />
                                            <ComboBoxItem Content="Fade" Tag="Fade" />
                                            <ComboBoxItem Content="Slide" Tag="Slide" />
                                            <ComboBoxItem Content="Page turn" Tag="PageTurn" />
                                        </ComboBox>
                                    </StackPanel>
                                    <ToggleSwitch x:Name="MangaToggle" Header="Manga direction" OffContent="Left to right" OnContent="Right to left" Toggled="ReaderSetting_Changed" />
                                    <ToggleSwitch x:Name="TranslationToggle" Header="Offline English translation" OffContent="Original page" OnContent="English overlay" Toggled="TranslationToggle_Toggled" />
                                    <ToggleSwitch x:Name="DimToggle" Header="Night dimming" OffContent="Off" OnContent="On" Toggled="ReaderSetting_Changed" />
                                    <TextBlock Foreground="{ThemeResource MutedBrush}" Text="Zoom" />
                                    <Slider x:Name="ZoomSlider" Minimum="50" Maximum="250" Value="100" ValueChanged="ZoomSlider_ValueChanged" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>

            <ScrollViewer x:Name="ReaderScroll" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" ZoomMode="Enabled" MinZoomFactor="0.5" MaxZoomFactor="4">
                <Grid x:Name="ReaderCanvas" MinHeight="400" Padding="28">
                    <StackPanel x:Name="ReaderPagesPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" Spacing="4" RenderTransformOrigin="0.5,0.5">
                        <StackPanel.RenderTransform><TranslateTransform x:Name="ReaderTranslate" /></StackPanel.RenderTransform>
                        <StackPanel.Projection><PlaneProjection x:Name="ReaderProjection" CenterOfRotationY="0.5" /></StackPanel.Projection>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
            <Canvas x:Name="PageCurlOverlay" Grid.Row="1" IsHitTestVisible="False" Visibility="Collapsed" />
            <Border x:Name="DimOverlay" Grid.Row="1" Background="#38000000" IsHitTestVisible="False" Visibility="Collapsed" />
            <Border x:Name="TranslationPanel" Grid.Row="1" Width="370" Margin="0,18,18,18" Padding="20" HorizontalAlignment="Right" VerticalAlignment="Stretch" Background="#F20A0A0A" BorderBrush="#333333" BorderThickness="1" CornerRadius="14" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="White" Text="English translation" />
                            <TextBlock x:Name="TranslationPageLabel" Margin="0,3,0,0" FontSize="11" Foreground="#92929B" />
                        </StackPanel>
                        <Button Grid.Column="1" Padding="8" Click="CloseTranslation_Click" ToolTipService.ToolTip="Show original only"><FontIcon Glyph="&#xE711;" /></Button>
                    </Grid>
                    <StackPanel Grid.Row="1" Margin="0,16,0,10" Orientation="Horizontal" Spacing="10">
                        <ProgressRing x:Name="TranslationProgress" Width="20" Height="20" IsActive="False" Visibility="Collapsed" />
                        <TextBlock x:Name="TranslationStatus" VerticalAlignment="Center" FontSize="12" Foreground="#A1A1AA" TextWrapping="Wrap" Text="Ready" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16">
                            <TextBlock x:Name="EnglishTranslationText" FontSize="18" LineHeight="27" Foreground="White" TextWrapping="Wrap" />
                            <Expander Header="Recognized Japanese">
                                <TextBlock x:Name="JapaneseTranslationText" Margin="0,8,0,0" FontSize="13" Foreground="#A1A1AA" TextWrapping="Wrap" />
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                    <Button Grid.Row="3" Margin="0,14,0,0" HorizontalAlignment="Left" Click="RefreshTranslation_Click">
                        <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE72C;" /><TextBlock Text="Translate again" /></StackPanel>
                    </Button>
                </Grid>
            </Border>

            <Grid x:Name="BubbleZoomOverlay" Grid.Row="1" Padding="36" Background="#B8000000" Visibility="Collapsed" Tapped="BubbleZoomBackdrop_Tapped">
                <Border x:Name="BubbleZoomCard" MaxWidth="920" MaxHeight="680" Padding="18" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#FF111318" BorderBrush="#4DFFFFFF" BorderThickness="1" CornerRadius="18" Tapped="BubbleZoomCard_Tapped" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform><ScaleTransform x:Name="BubbleZoomScale" ScaleX="1" ScaleY="1" /></Border.RenderTransform>
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="White" Text="Bubble Zoom" />
                                <TextBlock x:Name="BubbleZoomCounter" Margin="0,3,0,0" FontSize="12" Foreground="#A8B0BD" />
                            </StackPanel>
                            <Button Grid.Column="1" Padding="8" Click="CloseBubbleZoom_Click" ToolTipService.ToolTip="Close"><FontIcon Glyph="&#xE711;" /></Button>
                        </Grid>
                        <Border Grid.Row="1" Margin="0,16" MinWidth="340" MinHeight="220" Background="White" CornerRadius="12">
                            <Image x:Name="BubbleZoomImage" MaxWidth="840" MaxHeight="540" Stretch="Uniform" />
                        </Border>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Button x:Name="PreviousBubbleButton" Click="PreviousBubble_Click">
                                <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE76B;" /><TextBlock Text="Previous" /></StackPanel>
                            </Button>
                            <TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#A8B0BD" Text="Click outside or press Esc to close" />
                            <Button x:Name="NextBubbleButton" Grid.Column="2" Click="NextBubble_Click">
                                <StackPanel Orientation="Horizontal" Spacing="7"><TextBlock Text="Next" /><FontIcon Glyph="&#xE76C;" /></StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="GuidedViewOverlay" Grid.Row="1" Background="#FF030405" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition Width="76" /><ColumnDefinition Width="*" /><ColumnDefinition Width="76" /></Grid.ColumnDefinitions>
                <Button x:Name="PreviousGuidedPanelButton" Margin="12" HorizontalAlignment="Stretch" VerticalAlignment="Center" Click="PreviousGuidedPanel_Click" ToolTipService.ToolTip="Previous panel">
                    <FontIcon Glyph="&#xE76B;" FontSize="24" />
                </Button>
                <Grid Grid.Column="1" Padding="10">
                    <Image x:Name="GuidedPanelImage" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" Tapped="GuidedPanelImage_Tapped" RenderTransformOrigin="0.5,0.5">
                        <Image.RenderTransform><TranslateTransform x:Name="GuidedPanelTranslate" /></Image.RenderTransform>
                    </Image>
                    <Border Padding="12,7" Margin="12" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#B8121419" CornerRadius="12">
                        <TextBlock x:Name="GuidedPanelCounter" Foreground="White" FontSize="12" />
                    </Border>
                    <TextBlock Margin="0,0,0,10" HorizontalAlignment="Center" VerticalAlignment="Bottom" Foreground="#8FA0AE" Text="Click the panel or press Space to continue" />
                </Grid>
                <Button x:Name="NextGuidedPanelButton" Grid.Column="2" Margin="12" HorizontalAlignment="Stretch" VerticalAlignment="Center" Click="NextGuidedPanel_Click" ToolTipService.ToolTip="Next panel">
                    <FontIcon Glyph="&#xE76C;" FontSize="24" />
                </Button>
            </Grid>

            <Grid Grid.Row="2" Padding="24,12" Background="#E610131A">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Button Width="48" Height="48" Click="PreviousPage_Click" ToolTipService.ToolTip="Previous page"><FontIcon Glyph="&#xE76B;" /></Button>
                <StackPanel Grid.Column="1" Margin="20,0" VerticalAlignment="Center">
                    <Slider x:Name="PageSlider" Minimum="1" Maximum="1" Value="1" ValueChanged="PageSlider_ValueChanged" />
                    <TextBlock HorizontalAlignment="Center" FontSize="11" Foreground="#7E8899" Text="← / → to turn pages · Space for next" />
                </StackPanel>
                <Button Grid.Column="2" Width="48" Height="48" Click="NextPage_Click" ToolTipService.ToolTip="Next page"><FontIcon Glyph="&#xE76C;" /></Button>
            </Grid>
        </Grid>

        <Grid x:Name="WebSeriesView" Grid.RowSpan="2" Background="{ThemeResource AppBackgroundBrush}" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="64" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid Background="{ThemeResource NavBackgroundBrush}" BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition x:Name="WebCaptionInsetColumn" Width="148" />
                </Grid.ColumnDefinitions>
                <Button Margin="14,10" Click="CloseWebSeries_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72B;" /><TextBlock Text="Library" /></StackPanel>
                </Button>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="WebSeriesTitle" HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource InkBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="WebSeriesStatus" HorizontalAlignment="Center" FontSize="11" Foreground="{ThemeResource MutedBrush}" Text="WeebCentral · Online reader" />
                </StackPanel>
                <Button Grid.Column="2" Margin="0,10,8,10" Click="OpenWebSeriesExternal_Click" ToolTipService.ToolTip="Open series in your browser"><FontIcon Glyph="&#xE774;" /></Button>
                <Button Grid.Column="3" Margin="0,10" Click="RefreshWebSeries_Click" ToolTipService.ToolTip="Refresh chapters"><FontIcon Glyph="&#xE72C;" /></Button>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="330" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Background="{ThemeResource NavBackgroundBrush}" BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,0,1,0">
                    <Grid Margin="14">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid Margin="8,4,8,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource InkBrush}" Text="Chapters" />
                            <TextBlock x:Name="WebChapterCount" Grid.Row="1" Margin="0,3,0,0" FontSize="12" Foreground="{ThemeResource MutedBrush}" />
                            <ComboBox x:Name="WebChapterSortBox" Grid.Column="1" Grid.RowSpan="2" Width="118" VerticalAlignment="Center" SelectionChanged="WebChapterSort_SelectionChanged">
                                <ComboBoxItem Content="Newest first" Tag="Newest" />
                                <ComboBoxItem Content="Oldest first" Tag="Oldest" />
                            </ComboBox>
                        </Grid>
                        <ListView x:Name="WebChapterList" Grid.Row="1" IsItemClickEnabled="True" ItemClick="WebChapterList_ItemClick" SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid MinHeight="54" Padding="8,6">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{ThemeResource InkBrush}" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="11" Foreground="{ThemeResource MutedBrush}" Text="{Binding DateLabel}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <Grid Grid.Column="1">
                    <Grid>
                        <WebView2 x:Name="WebReader" NavigationStarting="WebReader_NavigationStarting" NavigationCompleted="WebReader_NavigationCompleted" />
                        <StackPanel x:Name="WebReaderEmpty" Width="410" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                            <FontIcon HorizontalAlignment="Center" FontSize="46" Foreground="{StaticResource AccentBrush}" Glyph="&#xE8A9;" />
                            <TextBlock HorizontalAlignment="Center" FontSize="23" FontWeight="SemiBold" Foreground="{ThemeResource InkBrush}" Text="Choose a chapter" />
                            <TextBlock TextAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource MutedBrush}" Text="Select a chapter from the list to open WeebCentral’s reader inside InkShelf." />
                        </StackPanel>
                        <ProgressRing x:Name="WebReaderProgress" Width="42" Height="42" IsActive="False" Visibility="Collapsed" />
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <InfoBar x:Name="MessageBar" Grid.Row="1" Margin="260,12,24,0" VerticalAlignment="Top" IsClosable="True" IsOpen="False" Severity="Informational" />
    </Grid>
</Window>
